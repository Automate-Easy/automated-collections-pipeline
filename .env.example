# Pipeline execution mode:
#
# demo
#   Mock Galax Pay + Mock Z-API
#   Safe local execution. No external messages are sent.
#
# whatsapp
#   Mock Galax Pay + Real Z-API
#   Uses controlled mock business data but sends real WhatsApp messages.
#
# real
#   Real Galax Pay + Real Z-API
#   Requires credentials for both external integrations.
#
PIPELINE_MODE=demo


# Demo customer phone number.
#
# Optional in demo mode.
# Required in whatsapp mode because real WhatsApp messages will be sent.
# Not used in real mode, where phone numbers come from Galax Pay.
DEMO_PHONE=5511999999999


# Galax Pay / Celcoin credentials.
# Required only when PIPELINE_MODE=real.
GALAXPAY_ID=
GALAXPAY_HASH=


# Z-API credentials.
# Required when PIPELINE_MODE=whatsapp or PIPELINE_MODE=real.
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=